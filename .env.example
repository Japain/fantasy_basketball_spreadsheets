# Yahoo Fantasy Sports API Credentials
# Get these from https://developer.yahoo.com/apps/
YAHOO_CONSUMER_KEY=your_consumer_key_here
YAHOO_CONSUMER_SECRET=your_consumer_secret_here

# Yahoo OAuth tokens (automatically generated during authentication)
# You don't need to manually set these - they're created by the auth scripts
# YAHOO_ACCESS_TOKEN_JSON={"access_token":"...","refresh_token":"..."}

# Fantasy League Configuration
NBA_LEAGUE_ID=your_league_id_here
NBA_GAME_ID=466  # 466 for 2024-25 NBA season
INITIAL_AUCTION_BUDGET=225  # Your league's initial auction budget

# Google Sheets API Configuration
GOOGLE_CREDENTIALS_PATH=credentials/client_secret_*.json

# Discord Webhook Integration (Optional)
# Get webhook URL: Discord channel → Settings → Integrations → Webhooks
# Leave blank to disable Discord notifications
DISCORD_WEBHOOK_URL=

# Discord Role ID for error mentions (Optional)
# Enable Developer Mode in Discord → Right-click role → Copy ID
# Leave blank for no role mentions
DISCORD_ALERT_ROLE_ID=

# Game code (usually don't need to change this)
GAME_CODE=nba
